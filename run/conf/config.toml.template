[elasticsearch.read]
case_index = "<case_index>"
file_index = "<file_index>"
max_source_filter_length = 400

[build]
acl = ["*"]
data_release = "<data_release>"
build_version = "1"
spark_submit = "spark-submit"
output_log = "output.log"
error_log = "error.log"
driver = "/home/ssm-user/wd/mmrf-mutation-indexer/bin/driver.py"
pex_file = "/home/ssm-user/wd/mmrf-mutation-indexer/driver-all"
jar_dir = "/home/ssm-user/wd/mmrf-mutation-indexer/"

[elasticsearch.write]
batch_size_bytes = "10mb"
batch_size_entries = 500

[aws.s3]
host = "http://s3.us-east-1.amazonaws.com"
access_key = "PLACEHOLDER"
secret_key = "PLACEHOLDER"

[spark.sql.shuffle]
partitions = 12

[builders.gene_model]
census_file = "s3a://<bucket>/census.tsv.gz"
citobands_file = "s3a://<bucket>/cytoband.tsv.gz"
gene_model_file = "s3a://<bucket>/gene-model.ndjson.gz"
is_cached = true

[elasticsearch.connection]
nodes = "<elasticsearch>"
password = "<elasticsearch_password>"
use_ssl = false
user = "<elasticsearch_username>"
verify_certs = false

[indexd]
host = "<indexd>"
password = "<indexd_password>"
port = 80
user = "<indexd_username>"

[spark.submit]
deploy_mode = "cluster"

[spark.driver]
max_result_size = "4g"
memory = "6g"

[spark.executor]
cores = 4
instances = 6
memory = "16g"

[spark.executor_env]
TMPDIR = "/tmp"
SCIE_BASE = "/tmp/nce"
PEX_ROOT = "/tmp/pex"

[spark.yarn.app_master_env]
TMPDIR = "/tmp"
SCIE_BASE = "/tmp/nce"
PEX_ROOT = "/tmp/pex"
